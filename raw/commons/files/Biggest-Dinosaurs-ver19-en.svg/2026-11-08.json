  "credit_html": "<span class=\"int-own-work\" lang=\"en\">Own work</span>, based on <a href=\"//commons.wikimedia.org/wiki/File:Biggest-Dinosaurs-ver09-he.svg\" title=\"File:Biggest-Dinosaurs-ver09-he.svg\">File:Biggest-Dinosaurs-ver09-he.svg</a> and on <a href=\"//commons.wikimedia.org/wiki/File:Biggest-Dinosaurs-ver17-he.svg\" title=\"File:Biggest-Dinosaurs-ver17-he.svg\">File:Biggest-Dinosaurs-ver17-he.svg</a> and the following images: <a href=\"//commons.wikimedia.org/wiki/File:Largestdinosaursbysuborder_scale.png\" title=\"File:Largestdinosaursbysuborder scale.png\">File:Largestdinosaursbysuborder scale.png</a>, <a href=\"//commons.wikimedia.org/wiki/File:Argentinosaurus_9.svg\" title=\"File:Argentinosaurus 9.svg\">File:Argentinosaurus 9.svg</a>, <a href=\"//commons.wikimedia.org/wiki/File:Patagotitan-Scale-Diagram-Steveoc86.svg\" title=\"File:Patagotitan-Scale-Diagram-Steveoc86.svg\">File:Patagotitan-Scale-Diagram-Steveoc86.svg</a>, <a href=\"//commons.wikimedia.org/wiki/File:Puertasaurus_Size_Chart.svg\" title=\"File:Puertasaurus Size Chart.svg\">File:Puertasaurus Size Chart.svg</a>, <a href=\"//commons.wikimedia.org/wiki/File:Alamosaurus_Scale_Chart_Steveoc.svg\" title=\"File:Alamosaurus Scale Chart Steveoc.svg\">File:Alamosaurus Scale Chart Steveoc.svg</a> and <a href=\"//commons.wikimedia.org/wiki/File:Styracosaurus_Scale.svg\" title=\"File:Styracosaurus Scale.svg\">File:Styracosaurus Scale.svg</a> and <a href=\"//commons.wikimedia.org/wiki/File:Ankylosaurus_scale.png\" title=\"File:Ankylosaurus scale.png\">File:Ankylosaurus scale.png</a>. Many by <a href=\"//commons.wikimedia.org/wiki/User:Slate_Weasel\" title=\"User:Slate Weasel\">User:Slate Weasel</a> and <a href=\"//commons.wikimedia.org/wiki/User:Steveoc_86\" title=\"User:Steveoc 86\">User:Steveoc 86</a>",
