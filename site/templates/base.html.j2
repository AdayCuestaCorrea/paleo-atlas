<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ T.site_name }} · {{ T.tagline }}{% endblock %}</title>
  <meta name="description" content="{% block description %}{{ T.lead }}{% endblock %}">
  <link rel="canonical" href="{{ canonical }}">
  <link rel="alternate" hreflang="{{ lang }}" href="{{ canonical }}">
  <link rel="alternate" hreflang="{{ other }}" href="{{ alternate_absolute }}">
  <link rel="stylesheet" href="{{ base }}/static/style.css">
  <link rel="icon" href="{{ base }}/static/favicon.svg" type="image/svg+xml">
</head>
<body>
  <header class="masthead">
    <div class="wrap masthead__inner">
      <a class="brand" href="{{ url('home') }}"><span class="brand__mark" aria-hidden="true">✶</span> {{ T.site_name }}</a>
      <nav class="nav" aria-label="{{ T.site_name }}">
        <a href="{{ url('encyclopedia') }}"{% if page_kind in ('encyclopedia', 'group_index', 'period_index', 'country_index', 'taxa', 'taxon') %} aria-current="page"{% endif %}>{{ T.nav_encyclopedia }}</a>
        <a href="{{ url('recaps') }}"{% if page_kind in ('recaps', 'recap') %} aria-current="page"{% endif %}>{{ T.nav_recaps }}</a>
        <a href="{{ url('assess') }}"{% if page_kind == 'assess' %} aria-current="page"{% endif %}>{{ T.nav_assess }}</a>
        <form class="nav__search" action="{{ url('search') }}" role="search" data-suggest
              data-index="{{ url('search_index') }}" data-all="{{ T.suggest_all }}" data-none="{{ T.suggest_none }}">
          <input type="search" name="q" placeholder="{{ T.search_placeholder_short }}" aria-label="{{ T.search_label }}" autocomplete="off" aria-expanded="false">
          <ul class="suggest" hidden></ul>
        </form>
        <a class="nav__lang" href="{{ alternate }}" hreflang="{{ other }}" lang="{{ other }}" data-lang="{{ other }}">{{ T.other_language }}</a>
      </nav>
    </div>
  </header>
  <main class="wrap">
    {% block content %}{% endblock %}
  </main>
  <footer class="footer">
    <div class="wrap footer__inner">
      <p>{{ T.footer_disclaimer }}</p>
      <p>{{ T.footer_code }} <a href="https://www.gnu.org/licenses/agpl-3.0.html" rel="license noopener">AGPL-3.0</a> · {{ T.footer_text }} <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" rel="license noopener">CC BY-NC-SA 4.0</a> · {{ T.footer_data }}</p>
      <p>
        <a href="{{ url('sources') }}">{{ T.nav_sources }}</a> ·
        <a href="{{ url('assess') }}">{{ T.nav_assess }}</a> ·
        <a href="{{ url('status') }}">{{ T.nav_status }}</a> ·
        <a href="{{ url('about') }}">{{ T.nav_about }}</a> ·
        {{ t('footer_updated', date=fmt_date(built_on)) }}
        {%- if last_checked %} · {{ t('footer_checked', date=fmt_date(last_checked)) }}{% endif %}
      </p>
    </div>
  </footer>
  <script src="{{ base }}/static/app.js" defer></script>
  <script src="{{ base }}/static/search.js" defer></script>
</body>
</html>
