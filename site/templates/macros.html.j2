{# Small reusable pieces: taxon card, reliability badges, timeline event. #}

{% macro image(taxon, T, size="card") -%}
  {%- if taxon.image_url -%}
  <img class="pic pic--{{ size }}{% if taxon.image_source == 'phylopic' %} pic--silhouette{% endif %}"
       src="{{ taxon.image_url }}" alt="{{ taxon.taxon_name }}" loading="lazy" decoding="async">
  {%- else -%}
  <div class="pic pic--{{ size }} pic--empty" aria-hidden="true">✶</div>
  {%- endif -%}
{%- endmacro %}

{% macro card(taxon, lang, T, url, terms) -%}
<a class="card" href="{{ url('taxon', taxon.taxon_key) }}">
  {{ image(taxon, T) }}
  <span class="card__body">
    <span class="card__name"><em>{{ taxon.taxon_name }}</em></span>
    <span class="card__meta">
      {%- set group = terms.group(taxon.taxon_group, lang) -%}
      {%- if taxon.page_type == 'new' -%}
        {{ terms.age(taxon.age_text, lang) or '' }}{% if taxon.country %} · {{ terms.place(taxon.country, lang) }}{% endif %}
      {%- else -%}
        {% if taxon.page_type == 'genus' and group %}{{ group }} · {% endif %}{{ terms.span(taxon, lang)[0] or '' }}{% if taxon.family_name %} · {{ taxon.family_name }}{% endif %}
      {%- endif -%}
    </span>
  </span>
</a>
{%- endmacro %}

{% macro badges(study, T) -%}
<span class="badges">
  {%- if study.is_retracted %}<span class="badge badge--bad">{{ T.badge_retracted }}</span>{% endif -%}
  {%- if study.is_corrected %}<span class="badge badge--warn">{{ T.badge_corrected }}</span>{% endif -%}
  {%- if study.is_preprint %}<span class="badge badge--warn">{{ T.badge_preprint }}</span>{% endif -%}
  {%- if study.is_peer_reviewed_journal %}<span class="badge badge--ok">{{ T.badge_peer_reviewed }}</span>{% endif -%}
  {%- if study.in_trusted_journal %}<span class="badge badge--info">{{ T.badge_trusted }}</span>{% endif -%}
  {%- if study.in_doaj %}<span class="badge badge--info">{{ T.badge_doaj }}</span>{% endif -%}
  {%- if study.reliability_status == 'unverified' %}<span class="badge">{{ T.badge_unverified }}</span>{% endif -%}
</span>
{%- endmacro %}

{% macro event_date(e, T, fmt_date) -%}
<span class="event__date"{% if e.date_precision == 'seen' %} title="{{ T.date_seen_note }}"{% endif %}>{% if e.date_precision == 'seen' %}{{ T.date_seen }} {{ fmt_date(e.event_date) }}{% else %}{{ fmt_date(e.event_date, e.date_precision) }}{% endif %}</span>
{%- endmacro %}

{#- Spanish pages show the translated title first and the original below it. -#}
{% macro study_title(e, T, compact=False) -%}
{% set translated = T.lang == 'es' and e.title_es and e.title_es != e.title %}
{% if translated %}
  <span class="event__title" lang="es">{{ e.title_es }}</span>
  {% if not compact %}<span class="event__original" lang="en"><span class="tag">{{ T.article_in_english }}</span> {{ T.original_title }}: {{ e.title }}</span>{% endif %}
{% elif e.title %}
  <span class="event__title"{% if T.lang == 'es' %} lang="en"{% endif %}>{{ e.title }}</span>
{% endif %}
{%- endmacro %}

{#- What a taxonomic event says, e.g. "Brontosaurus, synonym of Apatosaurus". The
    name concerned is the page's own taxon unless the event names another one. -#}
{% macro event_claim(e, T, page_name) -%}
{%- if e.event_type in ['synonymized', 'replaced', 'recombined', 'invalidated', 'revalidated'] -%}
<span class="event__claim">{{ claim(T['claim_' ~ e.event_type], e.subject_name or page_name, e.related_name) }}</span>
{%- elif e.event_type == 'description' and e.subject_name -%}
<span class="event__claim">{{ claim(T.claim_description, e.subject_name) }}</span>
{%- endif -%}
{%- endmacro %}

{% macro event(e, T, fmt_date, url=None, show_taxon=False, page_name=None) -%}
<li class="event event--{{ e.event_type }}">
  {{ event_date(e, T, fmt_date) }}
  <span class="event__type">{{ T['event_' ~ e.event_type] }}</span>
  {% if show_taxon and e.taxon %}<a class="event__taxon" href="{{ url('taxon', e.taxon.taxon_key) }}"><em>{{ e.taxon.taxon_name }}</em></a>{% endif %}
  {{ event_claim(e, T, page_name) }}
  {% if e.event_type == 'entry_changed' %}
  <span class="event__title">{{ T.entry_changed_fields }}: {% for f in e.changed_fields %}{{ T['changed_' ~ f] }}{% if not loop.last %}, {% endif %}{% endfor %}</span>
  {% else %}
  {{ study_title(e, T) }}
  {% endif %}
  <span class="event__source">
    {%- if e.attribution %}<span class="event__by">{{ e.attribution }}{% if e.origin == 'backfill' %}, {{ e.event_date.year }}{% endif %}</span>{% endif -%}
    {%- if e.journal %}{% if e.attribution %} · {% endif %}<cite>{{ e.journal }}</cite>{% endif -%}
    {%- if e.doi %} · <a href="https://doi.org/{{ e.doi }}" rel="noopener">{{ T.doi }} {{ e.doi }}</a>{% endif -%}
    {%- if e.source_title %} · <span class="event__via">{{ T.event_via }} {{ e.source_title }}</span>{% endif -%}
  </span>
  {{ badges(e, T) }}
</li>
{%- endmacro %}

{# One genus in an encyclopedia index: name and time range, compact (lists of thousands). #}
{% macro genus_item(taxon, lang, url, terms) -%}
<li><a href="{{ url('taxon', taxon.taxon_key) }}"><em>{{ taxon.taxon_name }}</em></a>
  {%- set early, late = terms.span(taxon, lang) -%}
  {%- if early %} <span class="muted">{{ early }}{% if late and late != early %}–{{ late }}{% endif %}</span>{% endif -%}
</li>
{%- endmacro %}

{#- A long comma-separated list: the first ``limit`` items, the rest folded under
    ``more_label`` ("and 65 more"), without JavaScript. Items are already HTML. -#}
{% macro folded(items, more_label, limit=12) -%}
{%- for i in items[:limit] %}{{ i }}{% if not loop.last or items | length > limit %}, {% endif %}{% endfor -%}
{%- if items | length > limit %}<details class="more"><summary>{{ more_label }}</summary>{% for i in items[limit:] %}{{ i }}{% if not loop.last %}, {% endif %}{% endfor %}</details>{% endif -%}
{%- endmacro %}
