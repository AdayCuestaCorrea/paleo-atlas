{% extends "base.html.j2" %}
{% block title %}{{ T.recaps_title }} · {{ T.site_name }}{% endblock %}
{% block content %}
<h1>{{ T.recaps_title }}</h1>
<p class="lead">{{ T.recaps_lead }}</p>
<ul class="weeks">
  {% for key, n in weeks %}
  <li><a href="{{ url('recap', key) }}">{{ week_label(key) }}</a> <span class="muted">· {{ t('week_items', n=n) }}</span></li>
  {% endfor %}
</ul>
{% endblock %}
