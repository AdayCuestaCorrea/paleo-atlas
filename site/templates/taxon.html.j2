{% extends "base.html.j2" %}
{% from "macros.html.j2" import image, event, event_date, study_title %}
{% block title %}{{ taxon.taxon_name }} · {{ T.site_name }}{% endblock %}
{% block description %}{{ fallback or taxon.taxon_name }}{% endblock %}
{% block content %}
<article class="taxon">
  <header class="taxon__head">
    <figure class="taxon__figure">
      {% if taxon.image_url and taxon.image_page_url %}
      <a class="zoom" href="{{ taxon.image_page_url }}" data-viewer
         data-full="{{ taxon.image_url }}"
         data-caption="{{ T.image_credit }}: {{ taxon.image_author or '—' }} · {{ taxon.image_license }}"
         data-license-url="{{ taxon.image_license_url or '' }}" aria-label="{{ T.enlarge_image }}">
        {{ image(taxon, T, "hero") }}
      </a>
      {% else %}{{ image(taxon, T, "hero") }}{% endif %}
      <figcaption>
        {% if taxon.image_url %}
          {{ T.image_credit }}: {{ taxon.image_author or '—' }} ·
          {% if taxon.image_license_url %}<a href="{{ taxon.image_license_url }}" rel="license noopener">{{ taxon.image_license }}</a>{% else %}{{ taxon.image_license }}{% endif %}
          {% if taxon.image_page_url %} · <a href="{{ taxon.image_page_url }}" rel="noopener">{{ T.open_source }}</a>{% endif %}
          {% if taxon.image_level in ('genus', 'clade', 'group') %}<br><span class="note">{{ t('image_approx', level=T['level_' ~ taxon.image_level]) }}</span>{% endif %}
        {% else %}{{ T.no_image }}{% endif %}
      </figcaption>
    </figure>
    <div class="taxon__title">
      <p class="kicker">{{ T['block_' ~ taxon.taxonomic_block] }}{% set g = terms.group(taxon.taxon_group, lang, plural=True) %}{% if g %} · {{ g }}{% endif %}</p>
      <h1><em>{{ taxon.taxon_name }}</em></h1>
      {% if taxon.name_authors %}<p class="authority">{{ taxon.name_authors }}{% if taxon.naming_year %}, {{ taxon.naming_year }}{% endif %}</p>{% endif %}
      <dl class="facts">
        {% set nov = terms.novelty(taxon.novelty, lang) %}
        {% if nov %}<dt>{{ T.field_novelty }}</dt><dd>{{ nov[0] }}</dd>{% endif %}
        {% set status = terms.status(taxon.status, lang) %}
        {% if status %}<dt>{{ T.field_status }}</dt><dd>{{ status }}</dd>{% endif %}
        {% if taxon.age_text %}<dt>{{ T.field_age }}</dt><dd>{{ terms.age(taxon.age_text, lang) }}</dd>
        {% elif not taxon.early_interval %}<dt>{{ T.field_age }}</dt><dd class="muted">{{ T.unknown }}</dd>{% endif %}
        {% if taxon.type_locality %}<dt>{{ T.field_locality }}</dt><dd>{{ terms.locality(taxon.type_locality, lang) }}</dd>{% endif %}
        {% if taxon.countries %}<dt>{{ T.field_country }}</dt><dd>{% for c in taxon.countries %}{{ terms.place(c, lang) }}{% if not loop.last %}, {% endif %}{% endfor %}{% if taxon.regions %} ({% for r in taxon.regions %}{{ terms.place(r, lang) }}{% if not loop.last %}, {% endif %}{% endfor %}){% endif %}</dd>{% endif %}
        {% if taxon.family_name or taxon.order_name or taxon.class_name %}
          <dt>{{ T.field_classification }}</dt>
          <dd>{% for part in [taxon.family_name, taxon.order_name, taxon.class_name] if part %}{{ part }}{% if not loop.last %} › {% endif %}{% endfor %}</dd>
        {% endif %}
        {% if taxon.early_interval and taxon.first_appearance_max_ma is not none %}
          <dt>{{ T.field_time_range }}</dt>
          <dd>{{ t('time_range', early=terms.interval(taxon.early_interval, lang), late=terms.interval(taxon.late_interval, lang), max=num(taxon.first_appearance_max_ma), min=num(taxon.last_appearance_min_ma)) }}</dd>
        {% endif %}
        {% if taxon.occurrence_count %}<dt>{{ T.field_occurrences }}</dt><dd>{{ taxon.occurrence_count }}</dd>{% endif %}
      </dl>
      {% if taxon.pbdb_has_taxon %}<p class="note">{{ T.pbdb_credit }} <a href="https://paleobiodb.org/classic/basicTaxonInfo?taxon_no={{ taxon.pbdb_taxon_no | replace('txn:', '') }}" rel="noopener">Paleobiology Database</a> (<a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener">CC BY 4.0</a>).</p>{% endif %}
    </div>
  </header>

  {% if events %}
  <aside class="latest-box" aria-labelledby="latest-title">
    <h2 id="latest-title">{{ T.latest_for_taxon }}</h2>
    <ol>
      {% for e in events[:3] %}
      <li>{{ event_date(e, T, fmt_date) }} · <span class="event__type">{{ T['event_' ~ e.event_type] }}</span> {{ study_title(e, T, compact=True) }}</li>
      {% endfor %}
    </ol>
    <a href="#historial">{{ T.see_history }}{% if events | length > 3 %} ({{ events | length }}){% endif %}</a>
  </aside>
  {% endif %}

  <section class="block prose">
    <h2>{{ T.text_title }}</h2>
    {% if text %}
      {% for section in SECTION_ORDER %}
        {% for s in text.sections if s.section == section %}
          <h3>{{ T['section_' ~ section] }}</h3>
          <p>{% for sentence in s.sentences %}{{ prose(sentence.text) }}{% if sentence.refs %}<sup class="ref">{% for n in sentence.refs %}<a href="#src-{{ n }}">{{ n }}</a>{% if not loop.last %},{% endif %}{% endfor %}</sup>{% endif %} {% endfor %}</p>
        {% endfor %}
      {% endfor %}
      <p class="note">{{ T.ai_note }}</p>
    {% elif fallback %}
      <p>{{ fallback }}</p>
      {% if taxon.page_type == 'new' %}<p class="note">{{ T.fallback_note }}</p>{% endif %}
    {% endif %}
    {% if not text and taxon.page_type == 'known' %}<p class="note">{{ T.known_note }}</p>{% endif %}
  </section>

  {% if gallery %}
  <section class="block" id="imagenes">
    <h2>{{ T.gallery_title }}</h2>
    {% set kinds = gallery | map(attribute='image_kind') | unique | list %}
    {% if gallery | length >= 6 and kinds | length >= 3 %}
    <div class="gallery__filters" role="group" aria-label="{{ T.gallery_filter }}">
      <button type="button" class="chip chip--on" data-kind="" aria-pressed="true">{{ T.search_all }}</button>
      {% for k in kinds %}<button type="button" class="chip" data-kind="{{ k }}" aria-pressed="false">{{ T['kind_' ~ k] }}</button>{% endfor %}
    </div>
    {% endif %}
    <ul class="gallery">
      {% for img in gallery %}
      <li class="gallery__item" data-kind="{{ img.image_kind }}">
        <figure>
          <a href="{{ img.page_url }}" rel="noopener" data-viewer data-full="{{ img.large_url }}"
             data-caption="{{ T['kind_' ~ img.image_kind] }} · {{ T.image_credit }}: {{ img.author }} · {{ img.license }}"
             data-license-url="{{ img.license_url or '' }}" aria-label="{{ T.enlarge_image }}: {{ T['kind_' ~ img.image_kind] }}">
            <img src="{{ img.thumb_url }}" alt="{{ T['kind_' ~ img.image_kind] }} · {{ taxon.taxon_name }}" loading="lazy" decoding="async">
          </a>
          <figcaption>
            <strong>{{ T['kind_' ~ img.image_kind] }}</strong> · {{ img.author }} ·
            {% if img.license_url %}<a href="{{ img.license_url }}" rel="license noopener">{{ img.license }}</a>{% else %}{{ img.license }}{% endif %}
          </figcaption>
        </figure>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <dialog class="viewer" aria-label="{{ T.enlarge_image }}">
    <figure>
      <img alt="">
      <figcaption><span class="viewer__caption"></span> · <a class="viewer__license" rel="license noopener">{{ T.license }}</a> · <a class="viewer__source" rel="noopener">{{ T.open_source }}</a></figcaption>
    </figure>
    <button type="button" class="viewer__prev" aria-label="{{ T.previous }}">‹</button>
    <button type="button" class="viewer__next" aria-label="{{ T.next }}">›</button>
    <button type="button" class="viewer__close" aria-label="{{ T.close }}">×</button>
  </dialog>

  <section class="block" id="historial">
    <h2>{{ T.history_title }}</h2>
    {% if events %}
      <ol class="timeline">{% for e in events %}{{ event(e, T, fmt_date) }}{% endfor %}</ol>
    {% else %}<p class="muted">{{ T.history_empty }}</p>{% endif %}
  </section>

  {% if not (text and text.sources) %}
  <section class="block">
    <h2>{{ T.sources_title }}</h2>
    <ul class="sources">
      {% for src in basic_sources %}<li><a href="{{ src.url }}" rel="noopener">{{ src.title }}</a>{% if src.note %} <span class="muted">· {{ src.note }}</span>{% endif %}</li>{% endfor %}
    </ul>
  </section>
  {% endif %}
  {% if text and text.sources %}
  <section class="block">
    <h2>{{ T.sources_title }}</h2>
    <ol class="sources">
      {% for src in text.sources %}
      <li id="src-{{ src.number }}">
        {% if src.source == 'wikipedia_article' %}
          Wikipedia: <em>{{ src.title }}</em> —
          {% for l in src.links %}<a href="{{ l.url }}" rel="noopener" hreflang="{{ l.lang }}">{{ T['in_lang_' ~ l.lang] }}</a>{% if not loop.last %} · {% endif %}{% endfor %}
        {% elif src.links %}<a href="{{ src.links[0].url }}" rel="noopener">{{ src.title | md }}</a>
        {% else %}{{ src.title | md }}{% endif %}
        {% if src.doi %} · <span class="muted">{{ T.doi }} {{ src.doi }}</span>{% endif %}
        {% if src.license %} <span class="muted">· {{ src.license }}</span>{% endif %}
      </li>
      {% endfor %}
    </ol>
  </section>
  {% endif %}
</article>
<script src="{{ base }}/static/viewer.js" defer></script>
{% endblock %}
